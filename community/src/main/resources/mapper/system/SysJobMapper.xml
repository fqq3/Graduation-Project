<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fqq.futurecommunity.system.mapper.SysJobMapper">

    <sql id="selectJobColumns">
        select
            job_id as jobId,
            job_name as jobName,
            job_group as jobGroup,
            invoke_target as invokeTarget,
            cron_expression as cronExpression,
            misfire_policy as misfirePolicy,
            concurrent,
            status,
            create_by as createBy,
            create_time as createTime,
            update_by as updateBy,
            update_time as updateTime,
            remark
        from sys_job
    </sql>

    <sql id="jobWhere">
        <where>
            <if test="job.jobName != null and job.jobName != ''">
                and job_name like concat('%', #{job.jobName}, '%')
            </if>
            <if test="job.jobGroup != null and job.jobGroup != ''">
                and job_group = #{job.jobGroup}
            </if>
            <if test="job.status != null and job.status != ''">
                and status = #{job.status}
            </if>
        </where>
    </sql>

    <select id="selectJobPage" resultType="com.fqq.futurecommunity.system.domain.SysJob">
        <include refid="selectJobColumns" />
        <include refid="jobWhere" />
        order by job_id desc
    </select>

    <select id="selectJobList" resultType="com.fqq.futurecommunity.system.domain.SysJob">
        <include refid="selectJobColumns" />
        <include refid="jobWhere" />
        order by job_id desc
    </select>
</mapper>
